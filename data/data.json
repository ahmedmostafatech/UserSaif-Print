  "faq": [
    { "q": "كيف أبدأ طلبًا؟", "a": "من صفحة «ابدأ طلبك»: اختر الخدمة، حدد المواصفات، ارفع تصميمك، ثم راجع الطلب وأرسله." },
    { "q": "هل يمكنني الطلب بدون تصميم جاهز؟", "a": "نعم، اختر «أحتاج مساعدة في التصميم» في خطوة التصميم واكتب ملاحظاتك." },
    { "q": "كيف أتابع طلبي؟", "a": "من صفحة «تتبع طلبك» باستخدام رقم الطلب ورقم الهاتف." },
    { "q": "ماذا يحدث بعد إرسال الطلب؟", "a": "يراجع صاحب المشروع الطلب ثم يوافق عليه أو يرفضه، وتظهر لك النتيجة والخطوة التالية في صفحة التتبع." },
    { "q": "ماذا يعني التاريخ المطلوب؟", "a": "هو التاريخ الذي تفضله لاستلام الطلب، وليس وعدًا بالتسليم." },
    { "q": "هل السعر الظاهر نهائي؟", "a": "الأسعار الموضحة تقديرية لحساب التكلفة الأولية، ويتم تأكيد السعر النهائي وموعد التسليم عند مراجعة تفاصيل التصميم والكميات بدقة." }
  ],

